# Copy this file to .env.local and fill with your local values.
# .env.local is git-ignored and must NEVER be committed.

# Local MySQL connection (the app connects as a non-root user).
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=cj_app
MYSQL_PASSWORD=your-app-db-password
MYSQL_DATABASE=constructora_cj

# Secret used to sign the session JWT cookie (min 16 chars; use a long random value).
AUTH_JWT_SECRET=change-me-to-a-long-random-secret
